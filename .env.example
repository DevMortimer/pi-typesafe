# Copy this file to .env and enter your key locally. Never commit .env.
TYPESAFE_API_KEY=
# Optional, explicit consent for automated/headless Pi tool calls:
# PI_TYPESAFE_ENABLED=1
# Optional, route judgments through another backend that serves the same protocol.
# One of: typesafe (default), openrouter, commandcode, liquid, subq. The key then comes
# from that backend's own variable (OPENROUTER_API_KEY, COMMANDCODE_API_KEY, LIQUID_API_KEY,
# SUBQ_API_KEY), not TYPESAFE_API_KEY, and /typesafe login does not apply.
# PI_TYPESAFE_BACKEND=openrouter
# Optional, override the backend's default model. Mapped to the backend's id form, so
# jev-1.14 becomes typesafe/jev-1.14 on OpenRouter and jev-latest becomes ~typesafe/jev-latest.
# PI_TYPESAFE_MODEL=jev-1.14
